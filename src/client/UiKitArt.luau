--!strict
-- LOOK-4 UI art on top of the HUD kit: the weapon icons (one small atlas,
-- rendered from the emplacement's weapons), the title key art backdrop and
-- the stencilled metal logo. Ids and cells come from UiKitArtAssets
-- (generated by tools/ui/publish_look.py luau --set art).
--
-- Everything degrades to the LOOK-2 look when an image is missing or fails
-- to load: slots keep their text, the title keeps its text logo and the
-- live title camera shows through. The key art and logo are title-only:
-- Screens releases them (Destroy) once the game starts, so their texture
-- memory is not held during waves.

local ContentProvider = game:GetService("ContentProvider")
local TweenService = game:GetService("TweenService")

local Ui = require(script.Parent.Ui)

local UiKitArt = {}

type ArtAssets = {
	icons: string,
	iconCells: { [string]: { offset: Vector2, size: Vector2 } },
	keyart: string?,
	keyartAspect: number,
	keyartFocusX: number,
	logo: string,
	logoSize: Vector2,
}

local art: ArtAssets? = nil
do
	local module = script.Parent:FindFirstChild("UiKitArtAssets")
	if module and module:IsA("ModuleScript") then
		local ok, result = pcall(require, module)
		if ok and typeof(result) == "table" then
			art = result :: any
		end
	end
end

UiKitArt.Assets = art

-- Fades `image` in once its texture has loaded; calls `onLoaded` then. A
-- fully transparent image is never drawn, so it never loads (IsLoaded stays
-- false, measured in Studio): it starts at 0.99, just visible enough for
-- the renderer to fetch it. IsLoaded fires no change signal, so this polls.
-- An image that never loads stays invisible (and `onLoaded` uncalled).
local LOAD_TIMEOUT = 30

local function fadeInWhenLoaded(image: ImageLabel, time: number, target: number, onLoaded: (() -> ())?)
	image.ImageTransparency = 0.99
	task.spawn(function()
		pcall(function()
			ContentProvider:PreloadAsync({ image })
		end)
		local started = os.clock()
		while image.Parent and not image.IsLoaded and os.clock() - started < LOAD_TIMEOUT do
			task.wait(0.1)
		end
		if not (image.Parent and image.IsLoaded) then
			return
		end
		if onLoaded then
			onLoaded()
		end
		TweenService:Create(image, TweenInfo.new(time, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { ImageTransparency = target }):Play()
	end)
end

---------------------------------------------------------------------------
-- Weapon icons
---------------------------------------------------------------------------

-- An ImageLabel showing `weapon`'s icon ("MG", "Rocket", "Missile"), or nil
-- when there is no icon art. The icon is light grey on a black outline:
-- ImageColor3 tints it (selected, idle, empty).
function UiKitArt.weaponIcon(weapon: string, props: { [string]: any }): ImageLabel?
	local a = art
	local cell = a and a.iconCells[weapon]
	if not (a and cell) then
		return nil
	end
	local defaults: { [string]: any } = {
		Name = "Icon",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Image = a.icons,
		ImageRectOffset = cell.offset,
		ImageRectSize = cell.size,
		ScaleType = Enum.ScaleType.Fit,
	}
	for k, v in props do
		defaults[k] = v
	end
	return Ui.new("ImageLabel", defaults)
end

---------------------------------------------------------------------------
-- Title logo
---------------------------------------------------------------------------

-- The stencilled metal logo as an ImageLabel `width` px wide (height from the
-- texture's aspect), hidden until loaded; `onLoaded` runs when it shows (the
-- title hides its text fallback then). Nil without logo art.
function UiKitArt.logo(props: { [string]: any }, width: number, onLoaded: () -> ()): ImageLabel?
	local a = art
	if not a then
		return nil
	end
	local defaults: { [string]: any } = {
		Name = "Logo",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Image = a.logo,
		Size = UDim2.fromOffset(width, math.floor(width * a.logoSize.Y / a.logoSize.X + 0.5)),
		ScaleType = Enum.ScaleType.Stretch,
	}
	for k, v in props do
		defaults[k] = v
	end
	local image = Ui.new("ImageLabel", defaults)
	fadeInWhenLoaded(image, 0.35, 0, onLoaded)
	return image
end

---------------------------------------------------------------------------
-- Title key art
---------------------------------------------------------------------------

export type Backdrop = {
	image: ImageLabel,
	release: () -> (),
}

-- Full-screen key art under `parent` (ZIndex `zIndex`), covering the screen
-- at its display aspect: on screens narrower than the art it is cropped
-- around `keyartFocusX`, on wider ones top and bottom. The texture is
-- stored anamorphic (squeezed into a square), so stretching it into the
-- display-aspect frame restores its proportions. Fades in once loaded;
-- until then (or if it never loads) the live title camera shows. Nil
-- without key art.
function UiKitArt.backdrop(parent: GuiObject, zIndex: number): Backdrop?
	local a = art
	local id = a and a.keyart
	if not (a and id) then
		return nil
	end
	local aspect, focus = a.keyartAspect, a.keyartFocusX
	local image = Ui.new("ImageLabel", {
		Name = "KeyArt",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Image = id,
		ScaleType = Enum.ScaleType.Stretch,
		ZIndex = zIndex,
		Parent = parent,
	})
	local function fit()
		local screen = parent.AbsoluteSize
		if screen.X <= 0 or screen.Y <= 0 then
			return
		end
		local w, h = screen.X, screen.X / aspect
		if h < screen.Y then
			w, h = screen.Y * aspect, screen.Y
		end
		-- Crop so the focus point keeps its place in the frame (x = focus *
		-- (screen - art) keeps it at the same fraction of the screen).
		image.Size = UDim2.fromOffset(math.ceil(w), math.ceil(h))
		image.Position = UDim2.fromOffset(math.floor(focus * (screen.X - w)), math.floor((screen.Y - h) / 2))
	end
	fit()
	local conn = parent:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit)
	fadeInWhenLoaded(image, 0.8, 0, nil)
	local released = false
	return {
		image = image,
		release = function()
			if released then
				return
			end
			released = true
			conn:Disconnect()
			image:Destroy()
		end,
	}
end

return UiKitArt
