--!strict
-- HUD kit (LOOK-2, FACELIFT_PLAN Phase 7): textured 9-slice panels in worn
-- olive metal with a scanline/grain overlay, corner brackets, a stencilled
-- top stripe, bar troughs with eased fills, scrolling hazard stripes, kit
-- buttons, and the small motion helpers (tweens, count-ups, slide-ins)
-- shared by Hud, WeaponHud, ThreatHud and Screens.
--
-- Textures: UiKitAssets (generated by tools/ui/publish_look.py from
-- tools/ui/ui_kit_textures.py): one 512² atlas + three tiles. If the atlas
-- fails to load, panels fall back to the old flat translucent fill so text
-- never sits on bare desert.

local ContentProvider = game:GetService("ContentProvider")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local FrameProfile = require(script.Parent.FrameProfile)

local Assets = require(script.Parent.UiKitAssets)
local Ui = require(script.Parent.Ui)

local UiKit = {}

local C = Ui.Colors
UiKit.Assets = Assets

-- Plate tints (multiplied over the olive texture).
UiKit.Tints = {
	Plate = Color3.new(1, 1, 1),
	PlateDim = Color3.fromRGB(150, 150, 140),
	Warning = Color3.fromRGB(255, 150, 130), -- red-brown plate for alerts
}

local GRAIN_TILE = 128
local HAZARD_TILE = 64
local STRIP_TILE = Vector2.new(64, 8)

local fallbackPlates: { ImageLabel } = {}
local failed = false

local function merge(defaults: { [string]: any }, props: { [string]: any }?): { [string]: any }
	if props then
		for k, v in props do
			defaults[k] = v
		end
	end
	return defaults
end

local function applyFallback(plate: ImageLabel)
	plate.BackgroundColor3 = C.Panel
	plate.BackgroundTransparency = 0.3
end

-- ImageLabel (or `className`) showing one atlas cell; 9-slice cells get
-- ScaleType.Slice with the cell's centre (SliceCenter is relative to the
-- ImageRect).
function UiKit.sprite(cellName: string, props: { [string]: any }?, className: string?): any
	local cell = Assets.cells[cellName]
	assert(cell, "unknown UiKit cell " .. cellName)
	local defaults: { [string]: any } = {
		Name = cellName,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Image = Assets.atlas,
		ImageRectOffset = cell.offset,
		ImageRectSize = cell.size,
		Size = UDim2.fromOffset(cell.size.X, cell.size.Y),
	}
	if cell.slice then
		defaults.ScaleType = Enum.ScaleType.Slice
		defaults.SliceCenter = cell.slice
	end
	return Ui.new(className or "ImageLabel", merge(defaults, props))
end

-- Tiled overlay image (grain / hazard / strip).
local function tile(image: string, tileSize: Vector2, props: { [string]: any }): ImageLabel
	return Ui.new("ImageLabel", merge({
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Image = image,
		ScaleType = Enum.ScaleType.Tile,
		TileSize = UDim2.fromOffset(tileSize.X, tileSize.Y),
	}, props))
end

export type PanelStyle = {
	brackets: boolean?, -- corner brackets (default false)
	stripe: boolean?, -- stencilled stripe along the top edge (default false)
	accent: Color3?, -- bracket/stripe colour (default amber)
	tint: Color3?, -- plate tint (default none)
	grain: boolean?, -- scanline/grain overlay (default true)
	fill: number?, -- plate ImageTransparency (default 0)
	solid: boolean?, -- extra dark backing under the fill (big panels over bright ground)
}

-- Adds corner brackets around `parent` (outset by `outset` px).
function UiKit.brackets(parent: GuiObject, color: Color3?, outset: number?, props: { [string]: any }?): ImageLabel
	local o = outset or 4
	return UiKit.sprite("brackets", merge({
		Name = "Brackets",
		ImageColor3 = color or C.Amber,
		Position = UDim2.fromOffset(-o, -o),
		Size = UDim2.new(1, o * 2, 1, o * 2),
		ZIndex = 1,
		Parent = parent,
	}, props))
end

-- Textured panel. Returns the plate (an ImageLabel): parent content to it
-- as usual; the grain overlay sits under content (ZIndex 0).
function UiKit.panel(props: { [string]: any }, style: PanelStyle?): ImageLabel
	local s: PanelStyle = style or {}
	local plate = UiKit.sprite("panel", merge({
		Name = "Panel",
		ImageColor3 = s.tint or UiKit.Tints.Plate,
		ImageTransparency = s.fill or 0,
	}, props))
	if s.grain ~= false then
		tile(Assets.grain, Vector2.new(GRAIN_TILE, GRAIN_TILE), {
			Name = "Grain",
			ImageTransparency = 0.3,
			Position = UDim2.fromOffset(1, 1),
			Size = UDim2.new(1, -2, 1, -2),
			ZIndex = 0,
			Parent = plate,
		})
	end
	if s.stripe then
		tile(Assets.strip, STRIP_TILE, {
			Name = "Stripe",
			ImageColor3 = s.accent or C.Amber,
			ImageTransparency = 0.2,
			Position = UDim2.fromOffset(14, 0),
			Size = UDim2.new(1, -28, 0, 8),
			ZIndex = 0,
			Parent = plate,
		})
	end
	if s.brackets then
		UiKit.brackets(plate, s.accent)
	end
	if s.solid then
		plate.BackgroundColor3 = C.Panel
		plate.BackgroundTransparency = 0.45
	end
	if failed then
		applyFallback(plate)
	else
		table.insert(fallbackPlates, plate)
	end
	return plate
end

-- Kit button: raised olive plate (ImageButton) + "Label" TextLabel +
-- amber brackets that open on hover. Set text with `button.Label.Text`.
function UiKit.button(props: { [string]: any }, text: string, textSize: number?): ImageButton
	local button = UiKit.sprite("button", merge({ Name = "Button", AutoButtonColor = false }, props), "ImageButton") :: ImageButton
	tile(Assets.grain, Vector2.new(GRAIN_TILE, GRAIN_TILE), {
		Name = "Grain",
		ImageTransparency = 0.3,
		Position = UDim2.fromOffset(2, 2),
		Size = UDim2.new(1, -4, 1, -4),
		ZIndex = 0,
		Parent = button,
	})
	local label = Ui.label({
		Name = "Label",
		Text = text,
		FontFace = Ui.Fonts.Header,
		TextSize = textSize or 28,
		TextColor3 = C.Amber,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 2,
		Parent = button,
	})
	Ui.outline(label, 1.5)
	local brackets = UiKit.brackets(button, C.Amber, 3)
	local hoverInfo = TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local function setHover(on: boolean)
		TweenService:Create(brackets, hoverInfo, {
			Position = UDim2.fromOffset(if on then -7 else -3, if on then -7 else -3),
			Size = UDim2.new(1, if on then 14 else 6, 1, if on then 14 else 6),
		}):Play()
		TweenService:Create(button, hoverInfo, {
			ImageColor3 = if on then Color3.fromRGB(255, 255, 235) else Color3.fromRGB(220, 220, 210),
		}):Play()
		label.TextColor3 = if on then C.Text else C.Amber
	end
	button.ImageColor3 = Color3.fromRGB(220, 220, 210)
	button.MouseEnter:Connect(function()
		setHover(true)
	end)
	button.MouseLeave:Connect(function()
		setHover(false)
	end)
	button.MouseButton1Down:Connect(function()
		button.ImageColor3 = Color3.fromRGB(160, 160, 150)
	end)
	button.MouseButton1Up:Connect(function()
		button.ImageColor3 = Color3.fromRGB(255, 255, 235)
	end)
	return button
end

-- ------------------------------------------------------------------ bars

export type Bar = {
	trough: ImageLabel,
	fill: ImageLabel,
	ghost: ImageLabel?,
	value: number,
	shown: number,
	ghostValue: number,
	ghostHold: number,
	rate: number,
}

export type BarOptions = {
	color: Color3?,
	segments: number?, -- dark dividers (e.g. 10 for integrity)
	ghost: Color3?, -- lagging "lost" segment colour (damage ghost)
	rate: number?, -- easing rate (1/s) of the shown value
	value: number?,
}

-- Inset trough with an eased fill. Drive it with UiKit.setBar + UiKit.stepBar.
function UiKit.bar(parent: Instance, props: { [string]: any }, opts: BarOptions?): Bar
	local o: BarOptions = opts or {}
	local trough = UiKit.sprite("trough", merge({ Name = "Bar", Parent = parent }, props))
	local clip = Ui.new("Frame", {
		Name = "Clip",
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Position = UDim2.fromOffset(2, 2),
		Size = UDim2.new(1, -4, 1, -4),
		Parent = trough,
	})
	local v = o.value or 1
	local ghost: ImageLabel? = nil
	if o.ghost then
		ghost = UiKit.sprite("fill", { Name = "Ghost", ImageColor3 = o.ghost, ImageTransparency = 0.15, Size = UDim2.fromScale(v, 1), ZIndex = 1, Parent = clip })
	end
	local fill = UiKit.sprite("fill", { Name = "Fill", ImageColor3 = o.color or C.Olive, Size = UDim2.fromScale(v, 1), ZIndex = 2, Parent = clip })
	if o.segments then
		for i = 1, o.segments - 1 do
			Ui.new("Frame", {
				Name = "Divider",
				BackgroundColor3 = Color3.fromRGB(10, 11, 7),
				BackgroundTransparency = 0.25,
				BorderSizePixel = 0,
				Position = UDim2.fromScale(i / o.segments, 0),
				Size = UDim2.new(0, 2, 1, 0),
				ZIndex = 3,
				Parent = clip,
			})
		end
	end
	return {
		trough = trough,
		fill = fill,
		ghost = ghost,
		value = v,
		shown = v,
		ghostValue = v,
		ghostHold = 0,
		rate = o.rate or 14,
	}
end

function UiKit.setBar(bar: Bar, value: number)
	value = math.clamp(value, 0, 1)
	if value < bar.value - 1e-4 and bar.ghost then
		bar.ghostHold = 0.45 -- the lost chunk lingers, then drains
		bar.ghostValue = math.max(bar.ghostValue, bar.shown)
	end
	bar.value = value
end

-- Snaps the shown value (no easing), e.g. on a new run.
function UiKit.snapBar(bar: Bar, value: number)
	bar.value = math.clamp(value, 0, 1)
	bar.shown = bar.value
	bar.ghostValue = bar.value
	bar.fill.Size = UDim2.fromScale(bar.shown, 1)
	if bar.ghost then
		bar.ghost.Size = UDim2.fromScale(bar.ghostValue, 1)
	end
end

function UiKit.stepBar(bar: Bar, dt: number)
	local k = 1 - math.exp(-bar.rate * dt)
	bar.shown += (bar.value - bar.shown) * k
	if math.abs(bar.value - bar.shown) < 0.001 then
		bar.shown = bar.value
	end
	bar.fill.Size = UDim2.fromScale(bar.shown, 1)
	local ghost = bar.ghost
	if ghost then
		if bar.ghostHold > 0 then
			bar.ghostHold -= dt
		else
			bar.ghostValue += (bar.shown - bar.ghostValue) * (1 - math.exp(-5 * dt))
		end
		bar.ghostValue = math.max(bar.ghostValue, bar.shown)
		ghost.Size = UDim2.fromScale(bar.ghostValue, 1)
	end
end

-- ------------------------------------------------------------------ hazard stripes

type Hazard = { holder: Frame, inner: ImageLabel, speed: number }
local hazards: { Hazard } = {}

-- Clipped strip of diagonal hazard stripes that scroll while visible.
function UiKit.hazard(parent: Instance, props: { [string]: any }, color: Color3, speed: number?, transparency: number?): Frame
	local holder = Ui.new("Frame", merge({
		Name = "Hazard",
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Parent = parent,
	}, props))
	local inner = tile(Assets.hazard, Vector2.new(HAZARD_TILE, HAZARD_TILE), {
		Name = "Stripes",
		ImageColor3 = color,
		ImageTransparency = transparency or 0,
		Size = UDim2.new(1, HAZARD_TILE, 1, 0),
		Parent = holder,
	})
	table.insert(hazards, { holder = holder, inner = inner, speed = speed or 40 })
	return holder
end

local function stepHazards()
	local t = os.clock()
	for i = #hazards, 1, -1 do
		local h = hazards[i]
		if not h.holder.Parent then
			table.remove(hazards, i)
		elseif h.holder.Visible then
			h.inner.Position = UDim2.fromOffset(-((t * h.speed) % HAZARD_TILE), 0)
		end
	end
end

-- ------------------------------------------------------------------ motion

function UiKit.tween(inst: Instance, time: number, props: { [string]: any }, style: Enum.EasingStyle?, direction: Enum.EasingDirection?): Tween
	local tween = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), props)
	tween:Play()
	return tween
end

local countTokens: { [Instance]: number } = {}

-- Counts `label` up from `from` to `to` over `duration` (ease-out), after
-- `delay`. `format` turns the number into the label text.
function UiKit.countUp(label: TextLabel, from: number, to: number, duration: number, format: (number) -> string, delay: number?)
	local token = (countTokens[label] or 0) + 1
	countTokens[label] = token
	label.Text = format(from)
	task.spawn(function()
		if delay and delay > 0 then
			task.wait(delay)
		end
		local started = os.clock()
		while countTokens[label] == token do
			local t = math.clamp((os.clock() - started) / duration, 0, 1)
			local eased = 1 - (1 - t) ^ 3
			label.Text = format(from + (to - from) * eased)
			if t >= 1 then
				break
			end
			RunService.RenderStepped:Wait()
		end
		if countTokens[label] == token then
			countTokens[label] = nil
		end
	end)
end

-- Cancels a running count-up on `label` (its text stays as it is).
function UiKit.stopCount(label: TextLabel)
	countTokens[label] = nil
end

-- Fades/slides a text label in: from `offset` px to its current position.
function UiKit.revealText(label: TextLabel, delay: number, offset: Vector2?)
	-- The first call records the label's resting position, so a reveal
	-- that interrupts another never drifts.
	local home = label:GetAttribute("KitHome")
	if typeof(home) ~= "UDim2" then
		home = label.Position
		label:SetAttribute("KitHome", home)
	end
	local target = home :: UDim2
	local o = offset or Vector2.new(-14, 0)
	label.TextTransparency = 1
	local stroke = label:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Transparency = 1
	end
	label.Position = target + UDim2.fromOffset(o.X, o.Y)
	task.delay(delay, function()
		UiKit.tween(label, 0.28, { TextTransparency = 0, Position = target }, Enum.EasingStyle.Quint)
		if stroke then
			UiKit.tween(stroke, 0.28, { Transparency = 0.2 })
		end
	end)
end

-- ------------------------------------------------------------------ start

-- Preloads the kit textures; on failure every panel switches to the flat
-- translucent fallback.
function UiKit.start()
	RunService.RenderStepped:Connect(FrameProfile.wrap("UiHazards", stepHazards))
	task.spawn(function()
		local probe = Instance.new("ImageLabel")
		probe.Image = Assets.atlas
		ContentProvider:PreloadAsync({ probe }, function(_, status)
			if status == Enum.AssetFetchStatus.Failure then
				failed = true
				warn("[RedMesa] HUD kit atlas failed to load; flat panels")
				for _, plate in fallbackPlates do
					applyFallback(plate)
				end
			end
		end)
		probe:Destroy()
		table.clear(fallbackPlates)
	end)
end

return UiKit
