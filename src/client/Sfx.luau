--!strict
-- Sound playback that never breaks gameplay: unknown or failing sounds are
-- silently skipped. All effects are original synthesized sounds packed into
-- one uploaded sound sheet (SfxSheet, generated by tools/audio); each name
-- plays its region of that sheet. Studio's built-in explosion is the only
-- other source, used as a fallback.

local ContentProvider = game:GetService("ContentProvider")
local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")

local SfxSheet = require(script.Parent.SfxSheet)

local Sfx = {}

-- Per-sound mix: volume, optional base pitch, max simultaneous voices,
-- and whether it's positional (plays in the world with distance falloff).
type Mix = { volume: number, pitch: number?, voices: number?, spatial: boolean? }

local MIX: { [string]: Mix } = {
	MachineGun = { volume = 0.42, voices = 8 },
	Overheat = { volume = 0.6 },
	Empty = { volume = 0.6 },
	Reload = { volume = 0.5 },
	WeaponSwitch = { volume = 0.5 },
	RocketLaunch = { volume = 0.75, voices = 3 },
	MissileLaunch = { volume = 0.75, voices = 3 },
	LockTone = { volume = 0.35, voices = 2 },
	LockAcquired = { volume = 0.4 },
	Explosion = { volume = 0.9, voices = 6, spatial = true },
	ExplosionSmall = { volume = 0.7, voices = 6, spatial = true },
	GrenadeBlast = { volume = 0.6, voices = 4 },
	AirBurst = { volume = 0.85, voices = 4, spatial = true },
	Ricochet = { volume = 0.35, voices = 4 },
	Hit = { volume = 0.35, voices = 4 },
	Kill = { volume = 0.45, voices = 3 },
	Damage = { volume = 0.55, voices = 3 },
	HeavyHit = { volume = 0.8, voices = 2 },
	Alarm = { volume = 0.35 },
	JetSiren = { volume = 0.55 },
	JetFlyby = { volume = 0.8, voices = 3, spatial = true },
	HeliRotor = { volume = 0.6, spatial = true },
	TankEngine = { volume = 0.6, spatial = true },
	BuggyEngine = { volume = 0.5, spatial = true },
	TankCannon = { volume = 0.85, voices = 3, spatial = true },
	CannonCharge = { volume = 0.7 },
	WaveStart = { volume = 0.6 },
	WaveClear = { volume = 0.6 },
	CratePickup = { volume = 0.6 },
	CrateDrop = { volume = 0.45 },
	Victory = { volume = 0.7 },
	Defeat = { volume = 0.7 },
	Wind = { volume = 0.18 },
	EnemyRifle = { volume = 0.35, voices = 6, spatial = true },
	HeliRockets = { volume = 0.7, voices = 3, spatial = true },
	BombWhistle = { volume = 0.6, voices = 3 },
	InfantryDeath = { volume = 0.4, voices = 4, spatial = true },
	-- Airdrop (AD-2). Positional ones are played by client/AirdropAudio
	-- with their own long-range falloff; these entries cover Sfx calls.
	TransportDrone = { volume = 0.9, spatial = true },
	DeflectPing = { volume = 0.32, voices = 3 },
	RampOpen = { volume = 0.8, spatial = true },
	ChutePop = { volume = 0.6, voices = 4, spatial = true },
	LandingThud = { volume = 0.6, voices = 4, spatial = true },
	PlatformThud = { volume = 0.9, voices = 2, spatial = true },
}

-- Aliases for names other modules use.
local ALIAS: { [string]: string } = {
	GrenadeBlast = "ExplosionSmall",
}

local FALLBACK_ID = "rbxasset://sounds/impact_explosion_03.mp3"
local voices: { [string]: { Sound } } = {}
local spatialAnchor: Attachment? = nil

local function regionFor(name: string)
	return SfxSheet.Regions[ALIAS[name] or name]
end

local function newSound(name: string): Sound?
	local region = regionFor(name)
	local mix = MIX[name] or { volume = 0.5 }
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.Volume = mix.volume
	sound.PlaybackSpeed = mix.pitch or 1
	if region then
		sound.SoundId = SfxSheet.SoundId
		sound.PlaybackRegionsEnabled = true
		sound.PlaybackRegion = NumberRange.new(region.start, region.stop)
		if region.loop then
			sound.LoopRegion = NumberRange.new(region.start, region.stop)
		end
	elseif name == "Explosion" then
		sound.SoundId = FALLBACK_ID
	else
		sound:Destroy()
		return nil
	end
	return sound
end

-- Returns a free (or the oldest) voice for `name`, creating up to the cap.
local function voiceFor(name: string): Sound?
	local pool = voices[name]
	if not pool then
		pool = {}
		voices[name] = pool
	end
	local cap = (MIX[name] and MIX[name].voices) or 1
	for _, s in pool do
		if not s.IsPlaying then
			return s
		end
	end
	if #pool < cap then
		local s = newSound(name)
		if s then
			s.Parent = SoundService
			table.insert(pool, s)
		end
		return s
	end
	-- Steal the voice that has played longest.
	local oldest = pool[1]
	for _, s in pool do
		if s.TimePosition > oldest.TimePosition then
			oldest = s
		end
	end
	return oldest
end

local function anchor(): Attachment
	if spatialAnchor and spatialAnchor.Parent then
		return spatialAnchor
	end
	local a = Instance.new("Attachment")
	a.Name = "SfxAnchor"
	a.Parent = Workspace.Terrain
	spatialAnchor = a
	return a
end

function Sfx.play(name: string, pitchJitter: number?, volumeScale: number?)
	local ok, err = pcall(function()
		local s = voiceFor(name)
		if not s then
			return
		end
		local mix = MIX[name] or { volume = 0.5 }
		s.PlaybackSpeed = (mix.pitch or 1) * (1 + (math.random() - 0.5) * (pitchJitter or 0))
		s.Volume = mix.volume * (volumeScale or 1)
		local region = regionFor(name)
		s.TimePosition = if region then region.start else 0
		s:Play()
	end)
	if not ok then
		warn("[RedMesa] sound failed: " .. name .. " " .. tostring(err))
	end
end

-- Plays a one-shot at a world position with distance falloff (explosions,
-- enemy fire). Falls back to 2D volume scaling for non-spatial sounds.
function Sfx.playAt(name: string, position: Vector3, pitchJitter: number?)
	local ok, err = pcall(function()
		local region = regionFor(name)
		local mix = MIX[name] or { volume = 0.5 }
		local s = newSound(name)
		if not s then
			return
		end
		local holder = Instance.new("Attachment")
		holder.WorldPosition = position
		holder.Parent = anchor().Parent
		s.RollOffMode = Enum.RollOffMode.InverseTapered
		s.RollOffMinDistance = 60
		s.RollOffMaxDistance = 1400
		s.Volume = mix.volume * 1.6
		s.PlaybackSpeed = (mix.pitch or 1) * (1 + (math.random() - 0.5) * (pitchJitter or 0))
		s.Parent = holder
		if region then
			s.TimePosition = region.start
		end
		s:Play()
		local length = if region then (region.stop - region.start) / s.PlaybackSpeed else 4
		task.delay(length + 0.2, function()
			holder:Destroy()
		end)
	end)
	if not ok then
		warn("[RedMesa] sound failed: " .. name .. " " .. tostring(err))
	end
end

-- Starts or stops a looping sound; repeated calls with the same state are free.
local loops: { [string]: Sound } = {}
function Sfx.setLoop(name: string, playing: boolean, volumeScale: number?)
	local current = loops[name]
	if current and volumeScale then
		local mix = MIX[name] or { volume = 0.5 }
		current.Volume = mix.volume * volumeScale
	end
	if playing == (current ~= nil) then
		return
	end
	if not playing and current then
		current:Destroy()
		loops[name] = nil
		return
	end
	local ok = pcall(function()
		local s = newSound(name)
		if not s then
			return
		end
		s.Looped = true
		if volumeScale then
			s.Volume *= volumeScale
		end
		s.Parent = SoundService
		local region = regionFor(name)
		if region then
			s.TimePosition = region.start
		end
		s:Play()
		loops[name] = s
	end)
	if not ok then
		loops[name] = nil
	end
end

-- Attaches a looping positional sound to a part (engines, rotors); returns
-- the Sound so callers can stop it, or nil.
function Sfx.attachLoop(name: string, part: BasePart): Sound?
	local ok, result = pcall(function()
		local s = newSound(name)
		if not s then
			return nil
		end
		s.Looped = true
		s.RollOffMode = Enum.RollOffMode.InverseTapered
		s.RollOffMinDistance = 40
		s.RollOffMaxDistance = 900
		s.Parent = part
		local region = regionFor(name)
		if region then
			s.TimePosition = region.start
		end
		s:Play()
		return s
	end)
	return if ok then result else nil
end

function Sfx.preload()
	task.spawn(function()
		local probe = Instance.new("Sound")
		probe.SoundId = SfxSheet.SoundId
		pcall(function()
			ContentProvider:PreloadAsync({ probe })
		end)
		probe:Destroy()
	end)
end

return Sfx
