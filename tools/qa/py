#!/usr/bin/env bash
# Runs a QA Python tool inside the project-local venv (.venv-qa, git-ignored),
# creating it with Pillow on first use.
#   tools/qa/py tools/qa/beauty_compare.py p0-baseline p1-env
set -eu
cd "$(dirname "$0")/../.."
VENV=.venv-qa
if [ ! -x "$VENV/bin/python" ] || ! "$VENV/bin/python" -c "import PIL" 2>/dev/null; then
	echo "creating $VENV (Pillow)..." >&2
	python3 -m venv "$VENV"
	"$VENV/bin/pip" install -q --disable-pip-version-check pillow >&2
fi
exec "$VENV/bin/python" "$@"
