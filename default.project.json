{
  "name": "RedMesaHoldout",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Remotes": {
        "$className": "Folder",
        "StartGame": {
          "$className": "RemoteEvent"
        },
        "Restart": {
          "$className": "RemoteEvent"
        },
        "RetryWave": {
          "$className": "RemoteEvent"
        },
        "FireWeapon": {
          "$className": "RemoteEvent"
        },
        "GameEvent": {
          "$className": "RemoteEvent"
        }
      },
      "GameState": {
        "$className": "Configuration"
      },
      "Assets": {
        "$path": "assets/roblox"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future"
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": false
      }
    }
  }
}